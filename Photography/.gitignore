# ---- 操作系统 / 编辑器 ----
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/

# ---- 后台 ----
# 自动备份由后台运行时生成，不入库（导出功能可生成正式的备份文件）
data/.backups/

# 管理员账号与会话密钥（含密码哈希），绝对不要提交
admin.config.json

# 运行时产物：PID 文件与日志（由 run.sh 生成）
.run/

# 打包产物：迁移到服务器用的 tar.gz（由 run.sh package 生成）
dist/

# ---- FFmpeg 内置二进制 ----
# 体积大且与平台绑定，不入库；用 tools/fetch_ffmpeg.py 或 ./run.sh install-ffmpeg 获取
bin/*
!bin/README.md

# ---- 依赖与构建产物 ----
node_modules/
dist/
build/
*.log

# ---- 内容 ----
# 原始照片通常体积很大，建议不要提交进版本库；
# 只保留已导出的缩略图与展示用图片。
assets/img/photos/originals/
assets/img/photos/raw/

# ---- 视频 ----
# 原始素材与未压缩文件不入库；只提交用于网页播放的压缩版本。
# 若压缩版本仍超过 50MB，建议改用 Git LFS：
#   git lfs install && git lfs track "assets/video/*.mp4"
assets/video/originals/
assets/video/raw/
*.mov
*.mkv
*.avi
